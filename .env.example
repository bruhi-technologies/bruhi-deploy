# ─────────────────────────────────────────────────────────────
# brūhi Cloud — Environment Configuration
# Copy this file to .env and fill in the required values.
# ─────────────────────────────────────────────────────────────

# ── Docker Compose Profiles ───────────────────────────────────
# Comma-separated list of active profiles.
# Available profiles:
#   bundled-icecast  — Starts a local Icecast container
#   proxy            — Starts Caddy for automatic HTTPS (requires DOMAIN)
#
# Common setups:
#   COMPOSE_PROFILES=bundled-icecast               # No SSL
#   COMPOSE_PROFILES=bundled-icecast,proxy         # SSL via Caddy (recommended)
COMPOSE_PROFILES=bundled-icecast,proxy

# ── Docker Image ──────────────────────────────────────────────
# Pin to a specific version for stability (e.g. v0.4.0)
IMAGE=ghcr.io/bruhi-technologies/bruhi-cloud:latest

# ── Server Settings ───────────────────────────────────────────
PORT=8000
LOG_LEVEL=warning

# Public URL users access the app on (required)
# Example: https://radio.yourdomain.com
BRUHI_URL=https://radio.yourdomain.com

# Your domain name (required when using the proxy profile)
DOMAIN=radio.yourdomain.com

# ── WebAuthn / Passkeys ───────────────────────────────────────
# Must match the hostname of BRUHI_URL (no https://, no port)
BRUHI_RP_ID=radio.yourdomain.com
BRUHI_RP_NAME=brūhi Cloud

# ── CORS ──────────────────────────────────────────────────────
# Space-separated list of additional allowed origins (optional)
CORS_ORIGINS=

# ── Pre-seeding Admin User (Optional) ────────────────────────
# If set and no users exist yet, these will be used to create
# the first owner account on startup.
# BRUHI_ADMIN_EMAIL=admin@yourdomain.com
# BRUHI_ADMIN_PASSWORD=changeme

# ── Icecast Passwords (Optional) ──────────────────────────────
# ICECAST_PASSWORD=hackme
# ICECAST_ADMIN_PASSWORD=hackme
# ICECAST_RELAY_PASSWORD=hackme


