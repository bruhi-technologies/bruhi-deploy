# ─────────────────────────────────────────────────────────────
# brūhi Cloud — Environment Configuration
# Copy this file to .env and fill in the required values.
# ─────────────────────────────────────────────────────────────

# ── Docker Compose Profiles ───────────────────────────────────
# Comma-separated list of active profiles.
# Available profiles:
#   proxy            — Mandatory Caddy reverse proxy for HTTPS, WebAuthn & secure sessions
#   bundled-icecast  — Starts a local Icecast container (optional)
#
# Configurations:
#   COMPOSE_PROFILES=bundled-icecast,proxy         # Bundled Icecast + HTTPS Caddy Proxy
#   COMPOSE_PROFILES=proxy                         # External Icecast + HTTPS Caddy Proxy
COMPOSE_PROFILES=bundled-icecast,proxy

# ── Icecast Mode ──────────────────────────────────────────────
# bundled  — Auto-creates Station 1 targeting internal Icecast on license activation
# external — Disables auto-creation (admin manually configures external Icecast output)
BRUHI_ICECAST_MODE=bundled

# ── Docker Image ──────────────────────────────────────────────
# Pin to a specific version for stability (e.g. v0.4.0)
IMAGE=ghcr.io/bruhi-technologies/bruhi-cloud:latest

# ── Server Settings ───────────────────────────────────────────
PORT=8000
LOG_LEVEL=warning

# Public URL users access the app on (required)
# Example: https://radio.yourdomain.com
BRUHI_URL=https://radio.yourdomain.com

# Your domain name (required when using the proxy profile)
DOMAIN=radio.yourdomain.com

# ── WebAuthn / Passkeys ───────────────────────────────────────
# Must match the hostname of BRUHI_URL (no https://, no port)
BRUHI_RP_ID=radio.yourdomain.com
BRUHI_RP_NAME=brūhi Cloud

# ── CORS ──────────────────────────────────────────────────────
# Space-separated list of additional allowed origins (optional)
CORS_ORIGINS=

# ── Pre-seeding Admin User (Optional) ────────────────────────
# If set and no users exist yet, these will be used to create
# the first owner account on startup.
# BRUHI_ADMIN_EMAIL=admin@yourdomain.com
# BRUHI_ADMIN_PASSWORD=changeme

# ── Icecast Streaming Passwords ────────────────────────────────
# ICECAST_SOURCE_PASSWORD=your_secure_source_password
# ICECAST_ADMIN_PASSWORD=your_secure_admin_password
# ICECAST_RELAY_PASSWORD=your_secure_relay_password


