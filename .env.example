# ─────────────────────────────────────────────────────────────
# brūhi Cloud — Environment Configuration
# Copy this file to .env and fill in the required values.
# ─────────────────────────────────────────────────────────────

# ── Docker Image ──────────────────────────────────────────────
# Pin to a specific version for stability (e.g. v0.4.0)
IMAGE=ghcr.io/bruhi-technologies/bruhi-cloud:latest

# ── Server Settings ───────────────────────────────────────────
PORT=8000
LOG_LEVEL=warning

# ── Domain & HTTPS (Required) ─────────────────────────────────
# Domain name for Caddy automatic HTTPS.
# Public URL (BRUHI_URL) and WebAuthn RP ID (BRUHI_RP_ID) automatically
# default to this domain (https://${DOMAIN}).
DOMAIN=radio.yourdomain.com

# ── Optional URL & Passkey Overrides ──────────────────────────
# Only uncomment if you need a custom protocol, port, or proxy rewrite:
# BRUHI_URL=https://radio.yourdomain.com
# BRUHI_RP_ID=radio.yourdomain.com
BRUHI_RP_NAME=brūhi Cloud

# ── CORS ──────────────────────────────────────────────────────
# Space-separated list of additional allowed origins (optional)
CORS_ORIGINS=

# ── Pre-seeding Admin User (Optional) ────────────────────────
# If set and no users exist yet, these will be used to create
# the first owner account on startup.
# BRUHI_ADMIN_EMAIL=admin@yourdomain.com
# BRUHI_ADMIN_PASSWORD=changeme

# ── Native HLS Audio Delivery ────────────────────────────────
# Path for tmpfs HLS playlist & segment storage (default: /hls)
# HLS_DIR=/hls
