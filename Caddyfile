{$DOMAIN} {
    # Icecast stream mounts (bundled Icecast server)
    # NOTE: *.mp3 glob intentionally removed — it would capture /api/media/*.mp3 requests
    # and route them to Icecast (which returns 404). Icecast stream URLs are served via
    # path prefixes (/station-*, /stream*, etc.) only.
    @icecast {
        path /station-* /stream* /live* /mount* /status.xsl /status-json.xsl
        not path /api/*
    }
    reverse_proxy @icecast icecast:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # WebSocket support (used by brūhi Studio live controls)
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websockets bruhi-cloud:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # All other requests
    reverse_proxy bruhi-cloud:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
