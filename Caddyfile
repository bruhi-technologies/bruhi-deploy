{$DOMAIN} {
    # Live HLS Audio Delivery
    # Reads from the shared hls_data volume mounted at /hls in both bruhi-cloud and caddy.
    handle_path /hls/* {
        root * /hls
        file_server

        header Access-Control-Allow-Origin *
        header Access-Control-Allow-Methods "GET, OPTIONS"
        header Access-Control-Allow-Headers "Range, Origin, Accept, Content-Type"

        # Playlist — never cache (must always be fresh)
        @m3u8 path *.m3u8
        header @m3u8 Cache-Control "no-cache, no-store, must-revalidate"

        # Segments — immutable (safe ONLY because epoch prefix prevents URL reuse)
        @segments path *.mp3 *.ts *.m4s
        header @segments Cache-Control "public, max-age=3600, immutable"
    }

    # WebSocket support (used by brūhi Studio live controls)
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websockets bruhi-cloud:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # All other requests
    reverse_proxy bruhi-cloud:8000 {
        flush_interval -1
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
